FREELLM_API_KEY=
FREELLM_API_BASE_URL=https://freellmapi-production-1175.up.railway.app/v1
# Follow the Railway service's active fallback chain.
FREELLM_MODEL=auto
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Exact repositories or owner/* entries (comma separated).
GITHUB_REPOSITORIES=your-user/*,your-org/*
BASE_BRANCH=default
# All observed checks must succeed; * accepts each repository's own CI names.
# Alternatively set a comma-separated list of required check names.
REQUIRED_CHECKS=*
MIN_APPROVALS=1
MERGE_METHOD=squash
# Set to false to enable actual merges after validating dry-run results.
DRY_RUN=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
