OPENROUTER_API_KEY=
# Use an OpenRouter model with tool calling and JSON schema support.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Exact repositories this deployment may merge (comma separated).
GITHUB_REPOSITORIES=your-org/your-repo
BASE_BRANCH=main
MERGE_LABEL=agent:merge
# Exact GitHub check-run names or commit status contexts; all must succeed.
REQUIRED_CHECKS=test,typecheck
MIN_APPROVALS=1
MERGE_METHOD=squash
# Set to false to enable actual merges after validating dry-run results.
DRY_RUN=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
