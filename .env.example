OPENROUTER_API_KEY=
# Use an OpenRouter model with tool calling and JSON schema support.
OPENROUTER_MODEL=openrouter/free
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Exact repositories or owner/* entries (comma separated).
GITHUB_REPOSITORIES=your-user/*,your-org/*
# Optional owner-specific token; hyphens in owner names become underscores.
# GITHUB_TOKEN_YOUR_ORG=
BASE_BRANCH=default
# All observed checks must succeed; * accepts each repository's own CI names.
# Alternatively set a comma-separated list of required check names.
REQUIRED_CHECKS=*
MIN_APPROVALS=1
MERGE_METHOD=squash
# Set to false to enable actual merges after validating dry-run results.
DRY_RUN=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
