{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*.ts"]
    }
  },
  "include": ["agent/**/*.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "oxfmt.config.ts"]
}
