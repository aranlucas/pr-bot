{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@aranlucas/oxforge/configs/recommended.json"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**",
    ".eve/**",
    ".output/**",
    ".vercel/**"
  ],
  "env": {
    "node": true
  },
  "rules": {
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "treatMethodsAsReadonly": true,
        "allow": [
          {
            "from": "lib",
            "name": ["Promise", "ReadonlySet"]
          },
          {
            "from": "package",
            "package": "@octokit/rest",
            "name": "Octokit"
          }
        ]
      }
    ]
  }
}
