{
  "name": "pr-bot",
  "version": "0.1.0",
  "private": true,
  "description": "An Eve agent that reviews GitHub PRs, posts findings, and merges eligible changes",
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE --strict -- eve dev",
    "build": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE --strict -- eve build",
    "start": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE --strict -- eve start",
    "typecheck": "tsc --noEmit",
    "test": "dotenvx run -f .env.test --overload --strict -- vitest run",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@aranlucas/kit-skills": "1.0.16",
    "@dotenvx/dotenvx": "^2.37.0",
    "@github-tools/eve-extension": "^0.8.1",
    "@github-tools/sdk": "^1.18.0",
    "@octokit/auth-app": "^8.3.1",
    "@vercel/connect": "^2.5.2",
    "ai": "^7.0.142",
    "eve": "^0.80.1",
    "just-bash": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@aranlucas/oxlint-plugin-anti-slop": "^0.1.0",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.14.0"
}
